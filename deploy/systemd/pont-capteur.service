[Unit]
Description=Pont capteur ESP32 vers MQTT
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=test
WorkingDirectory=/opt/spacefarm/spacefarm
# Variables de spacefarm/pont_capteur.py (ZONE_CIBLE, pas ZONE) ; PORT_SERIE : "COM3" par defaut
# (Windows), a adapter ici pour Linux, par exemple /dev/ttyUSB0.
Environment=ZONE_CIBLE=zone1
Environment=PORT_SERIE=/dev/ttyUSB0
ExecStart=/opt/spacefarm/spacefarm/.venv/bin/python pont_capteur.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
