[Unit]
Description=SpaceFarm API
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=test
WorkingDirectory=/opt/spacefarm/spacefarm
Environment=DUREE_CRISE_SECONDES=180
ExecStart=/opt/spacefarm/spacefarm/.venv/bin/python -m uvicorn api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
