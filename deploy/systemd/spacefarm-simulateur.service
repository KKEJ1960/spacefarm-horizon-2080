[Unit]
Description=SpaceFarm simulateur
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=test
WorkingDirectory=/opt/spacefarm/spacefarm
ExecStart=/opt/spacefarm/spacefarm/.venv/bin/python simulateur.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
